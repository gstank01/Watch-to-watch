# TMDB v3 API Read Access Token (Bearer). Server-side only.
TMDB_API_TOKEN=
# Override for tests (points at the mock TMDB server). Leave blank in production.
TMDB_API_BASE_URL=
DEFAULT_REGION=GB

# ---- Accounts (optional) ----
# Leave these blank and everything is saved in the visitor's browser only.
# All four groups below are needed to turn accounts on.

# Postgres connection string, e.g. from Neon or Supabase.
DATABASE_URL=
# 32+ random characters: openssl rand -base64 32
AUTH_SECRET=
# The site's public address, e.g. http://localhost:3000 or https://your-app.vercel.app
AUTH_URL=
# Email for sign-in links (https://resend.com). EMAIL_FROM must be on a domain you've
# verified in Resend, e.g. "WhatToWatch <signin@your-domain.com>".
# In `npm run dev` without these, sign-in links are printed in the terminal instead.
RESEND_API_KEY=
EMAIL_FROM=

# ---- Later milestones ----
CRON_SECRET=
